{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "support/**/*.ts",
    "hooks/**/*.ts",
    "pages/**/*.ts",
    "utils/**/*.ts",
    "features/**/*.ts",
    "smoke/**/*.ts",
    "playwright.config.ts"
  ]
}
