# Copy this file to ".env" and adjust the values below.
# Values in this file override the defaults defined in support/config.ts.

# Base URL of the application under test
BASE_URL=https://www.saucedemo.com

# Browser to use: chromium | firefox | webkit
BROWSER=chromium

# Run the browser in headless mode: true | false
HEADLESS=true

# Default timeout (ms) used by shared waits
TIMEOUT=15000
